# ==============================================================================
# HOROS PROBE-1 — Inference Worker Containerfile (OCI / Docker / Podman)
# Security Boundary: Low-Privilege Inference Worker
# Architecture: Read-Only Root, Non-Root Identity, Dropped Capabilities, No Network
# ==============================================================================

FROM python:3.12-slim-bookworm AS base

# Prevent Python from writing .pyc files and enable unbuffered output
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp

# Create dedicated unprivileged system group and user (UID/GID 10001:10001)
RUN groupadd --gid 10001 horos-worker \
    && useradd --uid 10001 --gid 10001 --shell /sbin/nologin --home-dir /tmp horos-worker

# Install minimal required runtime dependencies (CPU-only PyTorch, NumPy, SciPy)
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir \
        numpy==1.26.4 \
        torch==2.3.1 --index-url https://download.pytorch.org/whl/cpu \
        scipy==1.14.1

# Prepare application directory
WORKDIR /app

# Copy exclusively the world_model_vnext package source code
# NEVER copy private vaults, evaluation datasets, signing keys, or ledgers into the image!
COPY src/world_model_vnext /app/world_model_vnext

# Ensure /app is owned by root and readable by non-root, strictly non-writable
RUN chown -R root:root /app \
    && chmod -R 555 /app

# Switch permanently to unprivileged user
USER 10001:10001

# The container MUST be executed with:
#   --network none
#   --read-only
#   --user 10001:10001
#   --cap-drop ALL
#   --security-opt no-new-privileges:true
#   --tmpfs /tmp:rw,noexec,nosuid,size=64m
#   --memory 2g --cpus 2 --pids-limit 128
#   -v <candidate_checkpoint.pt>:/model/checkpoint.pt:ro
#
# Stdin / Stdout are used for HIPC (HOROS IPC) typed binary communication.
ENTRYPOINT ["python", "-u", "-m", "world_model_vnext.worker_isolation", "--worker"]
